# Required secret values for a local/self-hosted owner login
COAST_PASSWORD_HASH=
COAST_SESSION_SECRET=

# Required platform binding (configure a D1-compatible binding named COAST_CHAT_DB;
# this is documented here but is not a string secret value)
# COAST_CHAT_DB=

# Optional model provider
OPENROUTER_API_KEY=

# Optional development integrations
COAST_GITHUB_ALLOWED_REPOS=
COAST_GITHUB_TOKEN=
COAST_NOTION_ROOT_PAGE_ID=
COAST_NOTION_TOKEN=

# Optional MCP/OIDC
COAST_MCP_AUTH0_ISSUER=
COAST_MCP_AUTH0_AUDIENCE=
COAST_MCP_ALLOWED_SUBJECTS=
COAST_MCP_ALLOWED_EMAILS=
COAST_MCP_EMAIL_CLAIM=
COAST_MCP_EMAIL_VERIFIED_CLAIM=
